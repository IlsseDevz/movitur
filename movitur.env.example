# ============================================================

# Credenciais locais do MoviTur (NAO versionar)

# ------------------------------------------------------------

# Copie este ficheiro para "movitur.env" e preencha os valores.

#

# Desenvolvimento:  ./run-backend.ps1

# Producao:        ./build-prod.ps1  depois  ./run-prod.ps1

# ============================================================



# --- Base de dados PostgreSQL ---

MOVITUR_DB_URL=jdbc:postgresql://localhost:5432/movitur

MOVITUR_DB_DRIVER=org.postgresql.Driver

MOVITUR_DB_USER=postgres

MOVITUR_DB_PASS=a-sua-senha-postgres



# --- Email (Gmail SMTP) ---

MOVITUR_MAIL_USER=seu-email@gmail.com

MOVITUR_MAIL_PASS=xxxxxxxxxxxxxxxx

# Nome exibido no remetente dos emails

MOVITUR_MAIL_FROM_NAME=MoviTur

# Host/porta (por defeito Gmail SSL na porta 465)

# MOVITUR_MAIL_HOST=smtp.gmail.com

# MOVITUR_MAIL_PORT=465

# MOVITUR_MAIL_SSL=true

# MOVITUR_MAIL_STARTTLS=false



# --- URL da aplicacao (links nos emails) ---

MOVITUR_APP_URL=http://localhost:8080



# --- Admin (alertas de reservas/pagamentos + login back office) ---

MOVITUR_ADMIN_EMAIL=admin@movitur.co.mz

# MOVITUR_ADMIN_SENHA=troque-esta-senha



# --- Producao (obrigatorio alterar antes de deploy publico) ---

# Perfil Spring (run-prod.ps1 define prod automaticamente)

# SPRING_PROFILES_ACTIVE=prod

# Porta HTTP (opcional)

# MOVITUR_SERVER_PORT=8080

# Segredo JWT em Base64 (>= 256 bits). Gerar: openssl rand -base64 32

# MOVITUR_JWT_SECRET=

# Pasta de uploads de imagens (opcional)

# MOVITUR_UPLOAD_DIR=uploads

